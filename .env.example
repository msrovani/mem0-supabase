# Mem0-Supabase Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ============================================
# REQUIRED - Core Services
# ============================================

# PostgreSQL / Supabase Connection
POSTGRES_HOST=your-postgres-host
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password

# Supabase (alternative to direct PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_CONNECTION_STRING=postgresql://user:pass@host:5432/db
SUPABASE_COLLECTION_NAME=memories

# OpenAI (LLM + Embeddings)
OPENAI_API_KEY=sk-your-openai-key

# ============================================
# OPTIONAL - Graph Stores
# ============================================

# Neo4j
# NEO4J_URI=bolt://neo4j:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=your-neo4j-password

# Memgraph
# MEMGRAPH_URI=bolt://localhost:7687
# MEMGRAPH_USERNAME=memgraph
# MEMGRAPH_PASSWORD=your-memgraph-password

# ============================================
# OPTIONAL - Security
# ============================================

# JWT Authentication (required for production)
JWT_SECRET=your-jwt-secret-key-min-32-chars

# ============================================
# OPTIONAL - Caching
# ============================================

# Redis (L1 cache for HybridCache)
# ENABLE_REDIS_CACHE=false
# REDIS_URL=redis://localhost:6379
# REDIS_TTL_SECONDS=3600

# ============================================
# OPTIONAL - Performance Tuning
# ============================================

# Database Connection Pool
# DB_POOL_MIN=2
# DB_POOL_MAX=20
# DB_POOL_TIMEOUT=30

# ============================================
# OPTIONAL - CORS
# ============================================

# Allowed Origins (comma-separated)
# ALLOWED_ORIGINS=*

# ============================================
# OPTIONAL - Feature Flags
# ============================================

# Enable resonance between agents
# ENABLE_RESONANCE=false

# Enable background reflection
# ENABLE_REFLECTION=false
# REFLECTION_INTERVAL=5

# Enable dreaming mode
# ENABLE_DREAMING=false
# DREAMING_INTERVAL=10

# Enable ego/identity layer
# ENABLE_EGO=false

# Enable memory compression
# ENABLE_COMPRESSION=false
# COMPRESSION_THRESHOLD=0.92

# Enable context orchestrator (paging)
# ENABLE_PAGING=false
# CONTEXT_WINDOW_LIMIT=10

# Enable agentic compaction
# ENABLE_COMPACTION=false

# Enable heartbeats
# ENABLE_HEARTBEAT=false
# HEARTBEAT_INTERVAL=3600

# Enable memory bridge (multi-agent)
# ENABLE_BRIDGE=false

# Enable tool-state memory
# ENABLE_TOOL_STATE=false

# Enable hybrid search
# ENABLE_HYBRID_SEARCH=false

# Enable immutable memories
# ENABLE_IMMUTABLE_MEMORIES=true

# ============================================
# OPTIONAL - Audit Logging
# ============================================

# Audit log file path
# MEM0_AUDIT_LOG_FILE=/var/log/mem0/audit.log

# Enable async audit logging
# MEM0_AUDIT_LOG_ASYNC=0

# ============================================
# OPTIONAL - Memory Directory
# ============================================

# Local history database path
# MEM0_DIR=~/.mem0
